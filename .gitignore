# ==========================================================================
# Environment & Secrets (NEVER commit these!)
# ==========================================================================
.env
.env.*
!.env.example
!.env.production.example

# ==========================================================================
# Dependencies
# ==========================================================================
/node_modules
/vendor

# ==========================================================================
# Build & Cache
# ==========================================================================
/public_html/build
/public_html/hot
/public_html/storage
/bootstrap/cache/*.php
/storage/*.key
/storage/pail
*.log

# ==========================================================================
# IDE & Editor
# ==========================================================================
.DS_Store
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
Thumbs.db

# ==========================================================================
# Auth & Credentials
# ==========================================================================
/auth.json
*.pem
*.key
credentials.json
service-account.json

# ==========================================================================
# Local Development
# ==========================================================================
Homestead.json
Homestead.yaml
docker-compose.override.yml
.docker/

# ==========================================================================
# Testing
# ==========================================================================
.phpunit.result.cache
coverage/
.coverage

# ==========================================================================
# Database
# ==========================================================================
*.sqlite
*.sqlite-journal
database/*.sqlite
.claude/worktrees/
create_personal_access_tokens.sql
.claude/settings.local.json

# ==========================================================================
# Design-system handoff artifacts (source bundles, not part of the app)
# ==========================================================================
/XMAN Studio Design System-handoff.zip
/XMAN Studio Design System.zip
/XMAN Studio Design System2.zip
/design-system-source/
/retro-handoff-source/
/retro2-handoff-source/

# Local backup files (use git history for recovery, not .backup suffix)
*.backup

# DomPDF font metric caches — regenerated from the TTFs in this folder on first
# render. The TTFs themselves ARE tracked (see docs: fake Sarabun files once made
# every Thai PDF unreadable); only the derived caches are noise.
/storage/fonts/installed-fonts.json
/storage/fonts/*_*.ufm
/storage/fonts/*_*.ufm.json
/storage/fonts/*_*.ttf
