Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# No HTTPS redirect here: Cloudflare sits in front and terminates TLS, so an
# origin-side redirect can loop. Same as the other xman4289 static sites.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HTML and Next's RSC payloads (.txt) are the map to everything else —
  # never serve them stale. Covers the demos' index.html under /play/ too.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  # Build assets under /_next/static/ carry a content hash in their name,
  # so the URL is the cache key and a long TTL is safe.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Nova's stills/clips carry ?v= (CLIP_V in src/components/nova/clips.ts) —
  # bump it when a file is replaced under the same name: Cloudflare keys on the URL.
  <If "%{REQUEST_URI} =~ m#^/nova/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  # Game art has no version stamp: keep it short so a replaced picture shows within a day.
  <If "%{REQUEST_URI} =~ m#^/art/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
</IfModule>

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType image/webp .webp
</IfModule>
