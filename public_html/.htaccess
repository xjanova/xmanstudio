<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ไฟล์ที่ ReleaseDownloadStreamer ส่ง (/winx-tools/download[/{version}], /cluadex/download,
    # /gpuxmine/download, /download/{slug}/{version}, /api/download/{slug}[/{version}]) ต้องถึงลูกค้า
    # พร้อม Content-Length: เบราว์เซอร์รู้ขนาดและรู้ว่าไฟล์ขาด ตัวอัปเดต WinXTools เทียบขนาดทุก byte
    # Apache ทิ้งค่านี้สองชั้น: mod_deflate ของเซิร์ฟเวอร์ gzip ทุก response (zip บีบไม่ลงแต่เสียความยาว)
    # และตั้งแต่ 2.4.59 ไม่เชื่อ Content-Length ที่ PHP-FPM ส่งมา เว้นแต่ตั้ง ap_trust_cgilike_cl
    # เชื่อได้เพราะ streamer ไม่ส่งเกินขนาดที่ประกาศ · route APK รุ่นเก่าเอาขนาดจาก DB จึงไม่อยู่ในนี้
    # THE_REQUEST คือบรรทัดคำขอเดิม จึงตรงอีกครั้งตอน redirect ภายในไป index.php ซึ่งเป็นคำขอที่ตอบจริง
    RewriteCond %{THE_REQUEST} ^\S+\s/(?:(?:winx-tools|cluadex|gpuxmine)/download(?:/[^\s?/]+)?|download/[^\s?/]+/[^\s?/]+|api/download/[^\s?/]+(?:/[^\s?/]+)?)[?\s] [NC]
    RewriteRule ^ - [E=no-gzip:1,E=dont-vary:1,E=ap_trust_cgilike_cl:1]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
